{
  "metadata": {
    "projectType": "da"
  },
  "templates": [
    {
      "name": "about-us",
      "urls": [
        "https://wknd.site/us/en/about-us.html"
      ],
      "representativeUrl": "https://wknd.site/us/en/about-us.html",
      "description": "About Us page: page title, then two groups (Our Contributors, WKND Guides) each with an underlined heading, an intro paragraph and a grid of profile cards",
      "urlPattern": "/us/en/*",
      "blocks": [
        {
          "name": "cards-profile",
          "instances": [
            "main div.text.cmp-text--font-small + section.experiencefragment.cmp-experience-fragment--contributor"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Page title",
          "selector": [
            "main div.title.aem-GridColumn:not(.cmp-title--underline)"
          ],
          "style": null,
          "blocks": [],
          "defaultContent": [
            "main div.title.aem-GridColumn:not(.cmp-title--underline) h1"
          ]
        },
        {
          "id": "section-2",
          "name": "Our Contributors",
          "selector": [
            "main div.title.cmp-title--underline.aem-GridColumn:nth-of-type(2)",
            "main div.title.cmp-title--underline.aem-GridColumn"
          ],
          "style": null,
          "blocks": [
            "cards-profile"
          ],
          "defaultContent": [
            "main div.title.cmp-title--underline.aem-GridColumn h2",
            "main div.text.cmp-text--font-small.aem-GridColumn"
          ]
        },
        {
          "id": "section-3",
          "name": "WKND Guides",
          "selector": [
            "main div.title.cmp-title--underline.aem-GridColumn:nth-of-type(4)",
            "main div.title.cmp-title--underline.aem-GridColumn ~ div.title.cmp-title--underline.aem-GridColumn"
          ],
          "style": null,
          "blocks": [
            "cards-profile"
          ],
          "defaultContent": [
            "main div.title.cmp-title--underline.aem-GridColumn h2",
            "main div.text.cmp-text--font-small.aem-GridColumn"
          ]
        }
      ]
    },
    {
      "name": "magazine",
      "urls": [
        "https://wknd.site/us/en/magazine.html"
      ],
      "representativeUrl": "https://wknd.site/us/en/magazine.html",
      "description": "Magazine landing page: page title, featured article teaser, index-driven All Articles list, and Members Only locked teasers",
      "blocks": [
        {
          "name": "columns-featured",
          "instances": [
            "main div.teaser.cmp-teaser--featured"
          ]
        },
        {
          "name": "cards-dynamic",
          "instances": [
            "main div.image-list.list"
          ]
        },
        {
          "name": "cards-member-only",
          "instances": [
            "main div.teaser.cmp-teaser--secure:not(div.teaser.cmp-teaser--secure + div.teaser.cmp-teaser--secure)"
          ]
        }
      ],
      "urlPattern": "/us/en/magazine",
      "sections": [
        {
          "id": "section-1",
          "name": "Page title",
          "selector": [
            "main div.title.aem-GridColumn:not(.cmp-title--underline)"
          ],
          "style": null,
          "blocks": [],
          "defaultContent": [
            "main div.title.aem-GridColumn:not(.cmp-title--underline) h1"
          ]
        },
        {
          "id": "section-2",
          "name": "Featured article",
          "selector": [
            "main div.teaser.cmp-teaser--featured"
          ],
          "style": null,
          "blocks": [
            "columns-featured"
          ],
          "defaultContent": []
        },
        {
          "id": "section-3",
          "name": "All Articles",
          "selector": [
            "main div.title.cmp-title--underline.aem-GridColumn"
          ],
          "style": "yellow-underline",
          "blocks": [
            "cards-dynamic"
          ],
          "defaultContent": [
            "main div.title.cmp-title--underline.aem-GridColumn h2"
          ]
        },
        {
          "id": "section-4",
          "name": "Members Only",
          "selector": [
            "main div.title.cmp-title--underline.aem-GridColumn ~ div.title.cmp-title--underline.aem-GridColumn"
          ],
          "style": "yellow-underline, custom-separator",
          "blocks": [
            "cards-member-only"
          ],
          "defaultContent": [
            "main div.title.cmp-title--underline.aem-GridColumn h2",
            "main div.text.aem-GridColumn"
          ]
        }
      ]
    },
    {
      "name": "magazine-article",
      "urls": [
        "https://wknd.site/us/en/magazine/guide-la-skateparks.html",
        "https://wknd.site/us/en/magazine/arctic-surfing.html",
        "https://wknd.site/us/en/magazine/san-diego-surf.html",
        "https://wknd.site/us/en/magazine/ski-touring.html",
        "https://wknd.site/us/en/magazine/western-australia.html"
      ],
      "representativeUrl": "https://wknd.site/us/en/magazine/guide-la-skateparks.html",
      "description": "Magazine article: hero image, breadcrumb, article body with byline (left column) and a share rail with optional PDF download and up-next stories (right column)",
      "blocks": [
        {
          "name": "breadcrumb",
          "instances": [
            "main div.breadcrumb"
          ]
        },
        {
          "name": "cards-profile-horizontal",
          "instances": [
            "main .cmp-experiencefragment:not(.cmp-experiencefragment--header):not(.cmp-experiencefragment--footer)"
          ]
        },
        {
          "name": "cards-button",
          "instances": [
            "main aside.cmp-layoutcontainer--sidebar"
          ]
        }
      ],
      "urlPattern": "/us/en/magazine/*",
      "sections": [
        {
          "id": "section-1",
          "name": "Hero and breadcrumb",
          "selector": [
            "main div.image:not(.byline)"
          ],
          "style": null,
          "blocks": [
            "breadcrumb"
          ],
          "defaultContent": [
            "main div.image:not(.byline) img"
          ]
        },
        {
          "id": "section-2",
          "name": "Article",
          "selector": [
            "main main"
          ],
          "style": "aside, yellow-underline",
          "blocks": [
            "cards-profile-horizontal",
            "cards-button"
          ],
          "defaultContent": [
            "main main h1",
            "main main div.title h4",
            "main main article.contentfragment"
          ]
        }
      ]
    },
    {
      "name": "faqs",
      "urls": [
        "https://wknd.site/us/en/faqs.html"
      ],
      "representativeUrl": "https://wknd.site/us/en/faqs.html",
      "description": "FAQs page: title, hero image, intro text and an accordion of questions, with a 'Need more help?' contact aside",
      "blocks": [
        {
          "name": "accordion-divider",
          "instances": [
            "main div.accordion.panelcontainer",
            "main div.cmp-accordion"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "FAQs: main column and 'Need more help?' aside",
          "selector": [
            "main.container",
            "main"
          ],
          "style": "faq-aside, yellow-underline",
          "blocks": [
            "accordion-divider"
          ],
          "defaultContent": [
            "main div.title.cmp-title--underline h1",
            "main div.image img",
            "main div.image ~ div.text",
            "main div.container.responsivegrid + div.container.responsivegrid div.title h3",
            "main div.container.responsivegrid + div.container.responsivegrid div.text"
          ]
        }
      ]
    },
    {
      "name": "adventures-landing",
      "urls": [
        "https://wknd.site/us/en/adventures.html"
      ],
      "representativeUrl": "https://wknd.site/us/en/adventures.html",
      "description": "Adventures landing page: intro and a tabbed, filterable list of adventure cards (All plus one tab per activity)",
      "blocks": [
        {
          "name": "hero-boxed",
          "instances": [
            "main div.teaser.cmp-teaser--hero"
          ]
        },
        {
          "name": "cards-adventures",
          "instances": [
            "main div.tabs.panelcontainer"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Page title",
          "selector": [
            "main div.title:not(.cmp-title--underline)"
          ],
          "style": null,
          "blocks": [],
          "defaultContent": [
            "main div.title:not(.cmp-title--underline) h1"
          ]
        },
        {
          "id": "section-2",
          "name": "Intro teaser",
          "selector": [
            "main div.teaser.cmp-teaser--hero"
          ],
          "style": null,
          "blocks": [
            "hero-boxed"
          ],
          "defaultContent": []
        },
        {
          "id": "section-3",
          "name": "Current Adventures",
          "selector": [
            "main div.title.cmp-title--underline"
          ],
          "style": "yellow-underline, custom-separator",
          "blocks": [
            "cards-adventures"
          ],
          "defaultContent": [
            "main div.title.cmp-title--underline h2"
          ]
        }
      ]
    }
  ]
}
