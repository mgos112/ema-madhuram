          ]
        },
        {
          "name": "columns-featured",
          "instances": [
            "main div.teaser.cmp-teaser--featured"
          ]
        },
        {
          "name": "cards-dynamic",
          "instances": [
            "main div.image-list.list"
          ]
        },
        {
          "name": "hero-boxed",
          "instances": [
            "main div.teaser.cmp-teaser--hero:not(.carousel div)"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Hero carousel",
          "selector": [
