          "instances": [
            "main div.contentfragment:has(> .cmp-contentfragment > dl.cmp-contentfragment__elements)"
          ]
        },
        {
          "name": "tabs-adventure",
          "instances": [
            "main div.tabs.panelcontainer"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Breadcrumb and hero carousel",
          "selector": [
